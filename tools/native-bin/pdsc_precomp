#!/usr/bin/env python3
import sys

# Usage: pdsc_precomp <out_h> <out_c>
args = sys.argv[1:]
if len(args) < 2:
    sys.exit(1)

out_h = None
out_c = None
for a in args:
    if a.endswith('.h'): out_h = a
    elif a.endswith('.c'): out_c = a

if not out_h or not out_c:
    out_h = args[0]
    out_c = args[1]

programs = [
    'xfb_end',
    'xfb_init',
    'xfb_query_begin',
    'xfb_query_end',
    'xfb_vertex_count',
]

h_lines = [
    "/* Autogenerated file, do not edit. */",
    "#pragma once",
    "#include <stddef.h>",
    "#include <stdint.h>",
    "#include \"pdsc.h\"",
    "",
    "static inline unsigned",
    "pdsc_precomp_feature_index(enum pdsc_feature feature_variants, enum pdsc_feature features)",
    "{",
    "   (void)feature_variants; (void)features;",
    "   return 0;",
    "}",
    ""
]

for p in programs:
    h_lines.append(f"extern const uint32_t *pdsc_precomp_{p}[1];")
    h_lines.append(f"extern const size_t pdsc_precomp_{p}_size[1];")
    h_lines.append(f"static inline pdsc_program *pdsc_precomp_{p}_variant(void *mem_ctx, enum pdsc_feature features)")
    h_lines.append("{")
    h_lines.append("   (void)mem_ctx; (void)features;")
    h_lines.append("   return NULL;")
    h_lines.append("}")
    h_lines.append("")

c_lines = [
    "/* Autogenerated file, do not edit. */",
    "#include \"pdsc_precomp_programs.h\"",
    ""
]

for p in programs:
    c_lines.append(f"static const uint32_t pdsc_precomp_{p}_0[1] = {{ 0 }};")
    c_lines.append(f"const uint32_t *pdsc_precomp_{p}[1] = {{ pdsc_precomp_{p}_0 }};")
    c_lines.append(f"const size_t pdsc_precomp_{p}_size[1] = {{ sizeof(pdsc_precomp_{p}_0) }};")
    c_lines.append("")

with open(out_h, 'w') as f:
    f.write("\n".join(h_lines))

with open(out_c, 'w') as f:
    f.write("\n".join(c_lines))

sys.exit(0)

