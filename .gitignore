# Build directories and intermediates
build/
build-*/
research/mesa-src/build*/
*.o
*.a
*.so
*.ninja
.ninja_*
compile_commands.json

# Partition tools (host-only)
tools/lpdumps
tools/lpunpack

# Test binaries (compiled on host)
tests/test_bridge_v25_mock

# Device harness binary (built for the phone by tools/device/build_smoke.sh)
tools/device/vk_enum

# Proprietary OEM firmware and binary modules (preserves legal compliance)
firmware/
binaries/*.so
binaries/*.disasm
binaries/vkext
binaries/vkinfo
binaries/vkprops

# Raw device logs (contains device identifiers/OAuth tokens)
crash/logcat.txt

# Generated distribution archives
dist/*.zip
dist/standalone_icd/libvulkan_powervr_mesa.so

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editor and OS metadata
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

