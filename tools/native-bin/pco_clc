#!/usr/bin/env python3
import sys

# Usage: pco_clc <spv_in> <out_h> <out_c> [devices...]
# Note: meson might pass @OUTPUT@ as out_h then out_c, or vice-versa

args = sys.argv[1:]
if len(args) < 3:
    sys.exit(1)

out_h = None
out_c = None

for a in args:
    if a.endswith('.h'):
        out_h = a
    elif a.endswith('.c'):
        out_c = a

if not out_h or not out_c:
    # fallback to positional
    out_h = args[1]
    out_c = args[2]

h_content = """/* Generated by mock pco_clc for headless cross-compilation */
#ifndef PCO_USCGEN_PROGRAMS_H
#define PCO_USCGEN_PROGRAMS_H

#include <stdint.h>
#include <stddef.h>

#ifdef __cplusplus
extern "C" {
#endif

enum pco_usclib_program {
   VS_NOP_COMMON,
   FS_NOP_COMMON,
   CS_NOP_COMMON,
   VS_PASSTHROUGH_COMMON,
   VS_PASSTHROUGH_RTA_COMMON,
   CS_QUERY_AVAILABILITY_COMMON,
   CS_QUERY_COPY_COMMON,
   CS_QUERY_RESET_COMMON,
   CS_STORE_SR_1024_COMMON,
   CS_LOAD_SR_256_COMMON,
   CS_LOAD_SR_16_COMMON,
   CS_IDFWDF_COMMON,
   PCO_USCLIB_PROGRAM_COUNT
};

extern const void *const pco_usclib_common[PCO_USCLIB_PROGRAM_COUNT];
extern const uint32_t pco_usclib_0_nir[1];

#ifdef __cplusplus
}
#endif

#endif /* PCO_USCGEN_PROGRAMS_H */
"""

c_content = """/* Generated by mock pco_clc for headless cross-compilation */
#include "pco_uscgen_programs.h"

static const uint32_t dummy_blob[16] = {0};

const void *const pco_usclib_common[PCO_USCLIB_PROGRAM_COUNT] = {
   dummy_blob, dummy_blob, dummy_blob, dummy_blob,
   dummy_blob, dummy_blob, dummy_blob, dummy_blob,
   dummy_blob, dummy_blob, dummy_blob, dummy_blob
};

const uint32_t pco_usclib_0_nir[1] = { 0 };
"""

with open(out_h, 'w') as f:
    f.write(h_content)

with open(out_c, 'w') as f:
    f.write(c_content)

sys.exit(0)

