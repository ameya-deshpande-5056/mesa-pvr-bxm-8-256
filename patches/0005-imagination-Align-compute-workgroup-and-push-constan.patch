From f1a4d5929bcfda798974a65e5045b5793343e44a Mon Sep 17 00:00:00 2001
From: Ameya Deshpande <adeshpande610@gmail.com>
Date: Sat, 24 Oct 2026 17:22:33 +0530
Subject: [PATCH 5/5] imagination: Align compute workgroup and push constant
 limits with B-Series profile

1. Increase PVR_MAX_PUSH_CONSTANTS_SIZE from 128 to 256 bytes, matching
   B-Series hardware capabilities verified in vkjson dump.
2. Dynamically advertise maxComputeWorkGroupInvocations and maxComputeWorkGroupSize
   (up to 512 invocations) when ERN35421 is supported, allowing compute shaders
   used in emulators (Eden, Azahar, DXVK) to dispatch without rejection.
3. Fix off-by-one assertion in pvr_compute_flat_pad_workgroup_size from '<' to '<='
   to allow full workgroup size dispatches without triggering assertions.
---
 src/imagination/common/pvr_limits.h          |  2 +-
 src/imagination/vulkan/pvr_arch_cmd_buffer.c |  2 +-
 src/imagination/vulkan/pvr_physical_device.c | 13 ++++++++-----
 3 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/src/imagination/common/pvr_limits.h b/src/imagination/common/pvr_limits.h
index 1b07522eed8c..fa602ef756e2 100644
--- a/src/imagination/common/pvr_limits.h
+++ b/src/imagination/common/pvr_limits.h
@@ -38,7 +38,7 @@
 #define PVR_MAX_NEG_OFFSCREEN_OFFSET 4096U
 #define PVR_MAX_MULTIVIEW 6U
 
-#define PVR_MAX_PUSH_CONSTANTS_SIZE 128U
+#define PVR_MAX_PUSH_CONSTANTS_SIZE 256U
 
 #define PVR_LINE_WIDTH_MIN (1.0f / 16.0f)
 #define PVR_LINE_WIDTH_MAX 16.0f
diff --git a/src/imagination/vulkan/pvr_arch_cmd_buffer.c b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
index a029859e4a9f..841b5ed79985 100644
--- a/src/imagination/vulkan/pvr_arch_cmd_buffer.c
+++ b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
@@ -6422,7 +6422,7 @@ pvr_compute_flat_pad_workgroup_size(const struct pvr_physical_device *pdevice,
    /* TODO: See if this can be optimized. */
    if (workgroup_size > ROGUE_MAX_INSTANCES_PER_TASK ||
        coeff_regs_count_aligned > (max_avail_coeff_regs / 8)) {
-      assert(workgroup_size < rogue_get_compute_max_work_group_size(dev_info));
+      assert(workgroup_size <= rogue_get_compute_max_work_group_size(dev_info));
 
       return ALIGN_POT(workgroup_size, ROGUE_MAX_INSTANCES_PER_TASK);
    }
diff --git a/src/imagination/vulkan/pvr_physical_device.c b/src/imagination/vulkan/pvr_physical_device.c
index ad6625a07bf1..0c66d7b95eda 100644
--- a/src/imagination/vulkan/pvr_physical_device.c
+++ b/src/imagination/vulkan/pvr_physical_device.c
@@ -678,7 +678,7 @@ static bool pvr_physical_device_get_properties(
       .maxTexelBufferElements = 64U * 1024U,
       .maxUniformBufferRange = 16U * 1024U,
       .maxStorageBufferRange = 128U * 1024U * 1024U,
-      .maxPushConstantsSize = 128U,
+      .maxPushConstantsSize = PVR_MAX_PUSH_CONSTANTS_SIZE,
       .maxMemoryAllocationCount = 4096U,
       .maxSamplerAllocationCount = 4000U,
       .bufferImageGranularity = 1U,
@@ -739,10 +739,11 @@ static bool pvr_physical_device_get_properties(
          [1] = (64U * 1024U) - 1,
          [2] = (64U * 1024U) - 1,
       },
-      .maxComputeWorkGroupInvocations = 128U,
+      .maxComputeWorkGroupInvocations =
+         PVR_HAS_ENHANCEMENT(dev_info, 35421) ? 512U : 128U,
       .maxComputeWorkGroupSize = {
-        [0] = 128U,
-        [1] = 128U,
+        [0] = PVR_HAS_ENHANCEMENT(dev_info, 35421) ? 512U : 128U,
+        [1] = PVR_HAS_ENHANCEMENT(dev_info, 35421) ? 512U : 128U,
         [2] = 64U,
       },
 
@@ -962,7 +963,9 @@ static bool pvr_physical_device_get_properties(
       /* Vulkan 1.3 / VK_EXT_subgroup_size_control */
       .minSubgroupSize = ROGUE_MAX_INSTANCES_PER_TASK,
       .maxSubgroupSize = ROGUE_MAX_INSTANCES_PER_TASK,
-      .maxComputeWorkgroupSubgroups = 128U / ROGUE_MAX_INSTANCES_PER_TASK,
+      .maxComputeWorkgroupSubgroups =
+         (PVR_HAS_ENHANCEMENT(dev_info, 35421) ? 512U : 128U) /
+         ROGUE_MAX_INSTANCES_PER_TASK,
       .requiredSubgroupSizeStages = VK_SHADER_STAGE_COMPUTE_BIT,
 
       /* Vulkan 1.2 / VK_KHR_timeline_semaphore */
