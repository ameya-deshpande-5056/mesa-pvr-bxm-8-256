#!/usr/bin/env python3
import sys

output_file = None
dep_file = None

args = sys.argv[1:]
i = 0
while i < len(args):
    if args[i] == '-o' and i + 1 < len(args):
        output_file = args[i + 1]
        i += 2
    elif args[i] == '--depfile' and i + 1 < len(args):
        dep_file = args[i + 1]
        i += 2
    else:
        i += 1

if output_file:
    with open(output_file, 'wb') as f:
        # Minimal valid SPIR-V header: magic (0x07230203), version 1.0 (0x00010000), generator 0, bound 1, schema 0
        f.write(b'\x03\x02\x23\x07\x00\x00\x01\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00')

if dep_file:
    with open(dep_file, 'w') as f:
        f.write(f"{output_file}: \n")

sys.exit(0)

