+struct pvr_srv_connection {
+   int fd;
+   uint32_t ddk_major;
+   uint32_t ddk_minor;
+};
+
+#define MAX_PVR_SRV_CONNECTIONS 16
+static struct pvr_srv_connection s_connections[MAX_PVR_SRV_CONNECTIONS];
+static pthread_mutex_t s_conn_lock = PTHREAD_MUTEX_INITIALIZER;
+
+void pvr_srv_register_connection(int fd, uint32_t ddk_major, uint32_t ddk_minor)
+{
+   pthread_mutex_lock(&s_conn_lock);
+   for (int i = 0; i < MAX_PVR_SRV_CONNECTIONS; i++) {
+      if (s_connections[i].fd == fd || s_connections[i].fd == 0) {
+         s_connections[i].fd = fd;
+         s_connections[i].ddk_major = ddk_major;
+         s_connections[i].ddk_minor = ddk_minor;
+         break;
+      }
+   }
+   pthread_mutex_unlock(&s_conn_lock);
+}
+
+void pvr_srv_unregister_connection(int fd)
+{
+   pthread_mutex_lock(&s_conn_lock);
+   for (int i = 0; i < MAX_PVR_SRV_CONNECTIONS; i++) {
+      if (s_connections[i].fd == fd) {
+         s_connections[i].fd = 0;
+         s_connections[i].ddk_major = 0;
+         s_connections[i].ddk_minor = 0;
+         break;
+      }
+   }
+   pthread_mutex_unlock(&s_conn_lock);
+}
+
+static uint32_t pvr_srv_get_ddk_major(int fd)
+{
+   uint32_t major = 1;
+   pthread_mutex_lock(&s_conn_lock);
+   for (int i = 0; i < MAX_PVR_SRV_CONNECTIONS; i++) {
+      if (s_connections[i].fd == fd) {
+         major = s_connections[i].ddk_major;
+         break;
+      }
+   }
+   pthread_mutex_unlock(&s_conn_lock);
+   return major;
+}
